# ---- Authentication ----
# REQUIRED. Shared secret that every request must send as the `x-api-key`
# header. Without it the service refuses to boot, because every endpoint can act
# as the paired WhatsApp account: send messages, create groups, add participants,
# read pending join requests.
# Generate one with:  openssl rand -hex 32
SERVICE_API_KEY=

# Set 1 to run with NO request authentication. Only for a service that is
# genuinely unreachable from the internet. Ignored when SERVICE_API_KEY is set.
ALLOW_UNAUTHENTICATED=0

# ---- Core ----
# HTTP port. Most PaaS hosts (Railway, Render, Fly.io) assign this automatically.
PORT=3001

# Where Baileys stores session credentials. USE A PERSISTENT VOLUME in production,
# otherwise you must re-scan the QR after every deploy/restart.
AUTH_DIR=./whatsapp_auth

# Inbound messages are POSTed here as JSON. Leave unset to disable forwarding.
WHATSAPP_WEBHOOK_URL=

# Sent as the `x-whatsapp-secret` header on every webhook POST so your backend
# can verify the caller. Strongly recommended if WHATSAPP_WEBHOOK_URL is set.
WHATSAPP_WEBHOOK_SECRET=

# Comma-separated CORS allowlist. Default: * (any origin).
ALLOWED_ORIGINS=*

# Set 0 to NOT auto-connect on startup (connect manually via POST /init).
WHATSAPP_AUTO_INIT=1

# Pino log level for Baileys internals. Keep at "error" in production.
BAILEYS_LOG_LEVEL=error

# Debug logging toggles (1 to enable).
WHATSAPP_LOG_INCOMING_GROUP_MESSAGES=0
WHATSAPP_LOG_OWN_MESSAGES=0

# ---- Watchdog (auto-reconnect on silent/zombie socket) ----
# Set 1 to disable automatic reconnects entirely.
WHATSAPP_WATCHDOG_PAUSED=0

# How often the watchdog checks (ms).
WHATSAPP_WATCHDOG_INTERVAL_MS=60000

# Silence (no inbound message) before a "zombie" socket is force-reconnected (ms).
WHATSAPP_WATCHDOG_MAX_SILENCE_MS=900000

# Base cooldown between forced reconnects; doubles each consecutive recovery (ms).
WHATSAPP_WATCHDOG_COOLDOWN_MS=300000

# Cap for the exponential backoff (ms).
WHATSAPP_WATCHDOG_MAX_COOLDOWN_MS=3600000

# Stability window after which the backoff counter resets (ms).
WHATSAPP_WATCHDOG_QUIET_RESET_MS=7200000

# Active-hours window (local hour). The watchdog stays quiet outside it.
# END=24 means "through midnight".
WHATSAPP_WATCHDOG_ACTIVE_START=7
WHATSAPP_WATCHDOG_ACTIVE_END=24

# Whole hours east of UTC for the active-hours window above.
# e.g. -5 for US Eastern, +1 for Central Europe, 0 for UTC.
WHATSAPP_WATCHDOG_UTC_OFFSET=0
